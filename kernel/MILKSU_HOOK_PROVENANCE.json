  "runtime_contract": {
    "module_name": "kernelsu",
    "hot_unload_supported": false,
    "module_sysfs_visible": false,
    "module_sysfs_visible_when_debug_or_quarantined": true,
    "readonly_decimal_parameters": [
      "/sys/module/kernelsu/parameters/callbacks_pinned",
      "/sys/module/kernelsu/parameters/unload_supported",
      "/sys/module/kernelsu/parameters/unload_safe",
      "/sys/module/kernelsu/parameters/root_ready",
      "/sys/module/kernelsu/parameters/init_error"
    ],
    "load_success_requires": {
      "root_ready": 1,
      "init_error": 0,
      "userspace_probe": "successful GET_INFO through the ready-gated driver"
    },
    "unload_requires_explicit_sysfs_permission": true,
    "quarantine_ioctl_errno": "EHOSTDOWN",
    "guard_reference": "symbol_get(milksu_root_api_get) / symbol_put(milksu_root_api_get)",
    "guard_abi_version": 1
  },
  "setup_contract": {
    "source": "local script checkout or explicit MILKSU_SOURCE_ROOT",
    "network_access": false,
    "repository_mutations": false,
    "managed_driver": "drivers/milksu",
    "cleanup": "exact marked lines and matching symlink only",
    "reference_repositories_readonly": [
      "KernelSU",
      "KernelSU-Next",
      "KPatch-Next",
      "KPatch-Next-Module"
    ]
  }
